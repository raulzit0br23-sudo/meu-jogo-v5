func _ready() -> void:
	for lang in STRINGS:
		var tr_res := Translation.new()
		tr_res.locale = lang
		for k in STRINGS[lang]:
			tr_res.add_message(k, STRINGS[lang][k])
		for k in EXTRA[lang]:
			tr_res.add_message(k, EXTRA[lang][k])
		for k in EXTRA2[lang]:
			tr_res.add_message(k, EXTRA2[lang][k])
		TranslationServer.add_translation(tr_res)
	TranslationServer.set_locale("pt")

func set_language(lang: String) -> void:
	TranslationServer.set_locale(lang)

func t(key: String) -> String:
	var lang := TranslationServer.get_locale().substr(0, 2)
	if not STRINGS.has(lang): lang = "pt"
	if STRINGS[lang].has(key): return STRINGS[lang][key]
	if EXTRA[lang].has(key): return EXTRA[lang][key]
	if EXTRA2[lang].has(key): return EXTRA2[lang][key]
	return STRINGS["pt"].get(key, EXTRA["pt"].get(key, EXTRA2["pt"].get(key, key)))
